# Consolidated Lattice Analysis Suite
# - Single cell: simulations + one 6-panel figure
# - CSV summary printed below the figure with a highlighted date
import numpy as np
import matplotlib.pyplot as plt
from scipy.signal import welch
from datetime import datetime
import io, csv
np.random.seed(42)
# ---- Helper analysis functions ----
def analyze_lattice_coherence(series, fs=1.0):
    # Compute PSD via Welch; return freqs and PSD
    # Series should be 1D numpy array
    nperseg = min(2048, max(256, len(series)//8))
    freqs, psd = welch(series, fs=fs, nperseg=nperseg)
    return freqs, psd
def quantify_alpha_gap():
    # Minimal numeric "alpha" summary used in original notebook
    alpha_phys = 1.0 / 137.035999
    model_alpha = 1.0 / 137.0
    gap = abs(alpha_phys - model_alpha)
    return alpha_phys, model_alpha, gap
# ---- Saturation / lattice functions (basic + enhanced) ----
def basic_saturation(steps=5000, pc=0.95, noise=0.02):
    se = np.zeros(steps)
    resets = 0
    for i in range(1, steps):
        delta = np.random.normal(0.0, noise)
        se[i] = np.clip(se[i-1] + delta, 0.0, 1.0)
        if se[i] > pc:
            se[i] = 0.1 * pc # small reset
            resets += 1
    return se, resets
def enhanced_saturation(steps=20000, pc=0.0497, noise=0.008, wg=1.0, ww=1.0):
    se = np.zeros(steps)
    Ec = np.zeros(steps) # Coupling energy
    mode = np.zeros(steps, dtype=int) # 0: Straight, 1: Loop
    resets = 0
    for i in range(1, steps):
        phase_diff = np.cos(wg * i) * np.cos(ww * i)
        Ec[i] = 0.5 * phase_diff
        delta = np.random.normal(0.0, noise) + 0.1 * Ec[i]
        se[i] = np.clip(se[i-1] + delta, 0.0, 1.0)
        if se[i] > 0.92:
            se[i] = pc * 2
            resets += 1
            mode[i] = 1
        else:
            mode[i] = 0 if np.abs(phase_diff) < 0.1 else 1
    return se, Ec, mode, resets
# ---- Cycle-aware pump (wave solver / Kuramoto-ish order) ----
def cycle_aware_pump(num_cycles=200, drive_freq_hz=45000, nx=140, ny=90, c0=1.0):
    dx = 1.0 / nx
    period = 1.0 / drive_freq_hz
    total_time = num_cycles * period
    N_points_per_period = 20
    dt_temp_res = period / N_points_per_period
    dt_courant = 0.42 * dx / c0
    dt = min(dt_temp_res, dt_courant)
    steps = max(1, int(total_time / dt))
    # Tunable parameters
    diotic_weight = 0.48
    beta = 0.025
    drive_amp = 0.01
    strain_threshold = 0.038
    u = np.zeros((ny, nx))
    u_prev = np.zeros((ny, nx))
    x = np.linspace(0, 1, nx)
    y_grid = np.linspace(0, 1, ny)[:, None]
    width = 1.0 - (1.0 - 0.25) * x
    mask = (y_grid < width[None, :]).astype(float)
    c_field = c0 * (1.0 + diotic_weight * (1.0 - y_grid / (width[None, :] + 1e-12)))
    r_history = []
    emf_history = []
    dump_events = 0
    dumping = False
    dump_timer = 0
    for t in range(steps):
        laplacian = (np.roll(u, -1, 0) + np.roll(u, 1, 0) +
                     np.roll(u, -1, 1) + np.roll(u, 1, 1) - 4 * u) / dx**2
        u_new = 2 * u - u_prev + (dt**2 * c_field**2 * laplacian * mask)
        noise = 0.12 * np.random.normal(0, 1, ny)
        drive = drive_amp * np.sin(2 * np.pi * drive_freq_hz * t * dt)
        u_new[:, 0] += noise + drive
        u_new -= beta * (u_new ** 3)
        # Kuramoto-like phase order parameter in a middle strip
        u_dot = (u_new - u_prev) / (2 * dt + 1e-16)
        grad_x = (np.roll(u_new, -1, 1) - np.roll(u_new, 1, 1)) / (2 * dx + 1e-16)
        slice_x = slice(20, -20) if nx > 40 else slice(0, nx)
        phases = np.arctan2(u_dot[:, slice_x], c0 * grad_x[:, slice_x] + 1e-8)
        r_t = np.abs(np.mean(np.exp(1j * phases)))
        r_history.append(r_t)
        # Shishiodoshi valve
        sink = x > 0.82
        apex_strain = np.mean(np.abs(u_new[:, sink]))
        emf = 0.0
        if apex_strain > strain_threshold and not dumping:
            dumping = True
            dump_timer = 12
            dump_events += 1
        if dumping:
            u_new[:, sink] *= 0.32
            emf = 6200 * (apex_strain / (dt + 1e-16))
            dump_timer -= 1
            if dump_timer <= 0:
                dumping = False
        emf_history.append(emf)
        u_prev, u = u, u_new
    return np.array(r_history), np.array(emf_history), dump_events
def enhanced_kuramoto_pump(drive_freq, freq_scale=1.0, **kwargs):
    # Convenience wrapper: if drive_freq large (e.g., in kHz scale), multiply by scale
    if drive_freq > 1000 and freq_scale == 1.0:
        # assume user passed Hz already
        drive_freq_hz = drive_freq
    else:
        drive_freq_hz = drive_freq * freq_scale
    return cycle_aware_pump(drive_freq_hz=drive_freq_hz, **kwargs)
# ---- Run simulations ----
# Basic and enhanced saturations
se_basic, reset_count = basic_saturation(steps=5000, pc=0.92, noise=0.02)
se_enhanced, Ec_enhanced, mode_enhanced, resets_enhanced = enhanced_saturation(steps=20000)
# PSDs
freqs_se_basic, psd_se_basic = analyze_lattice_coherence(se_basic, fs=1.0)
freqs_se_enhanced, psd_se_enhanced = analyze_lattice_coherence(se_enhanced, fs=1.0)
# Cycle-aware pump sample run + sweep for resonance map (kept short to be interactive)
r_sample, emf_sample, dumps_sample = cycle_aware_pump(num_cycles=150, drive_freq_hz=45000)
freq_range_hz = np.linspace(44500, 45500, 20)
mean_r_values = []
dump_counts = []
for f in freq_range_hz:
    r_tmp, emf_tmp, dumps_tmp = cycle_aware_pump(num_cycles=120, drive_freq_hz=f)
    mean_r_values.append(np.mean(r_tmp))
    dump_counts.append(dumps_tmp)
# Quantify alpha metrics
alpha_phys, model_alpha, gap = quantify_alpha_gap()
# ---- Plot single 3x2 figure ----
plt.style.use('dark_background')
fig, axes = plt.subplots(nrows=3, ncols=2, figsize=(15, 12))
fig.suptitle('Combined Simulation Analysis (Consolidated)', fontsize=16)
# Panel 1: Se Basic (short-term)
axes[0, 0].plot(se_basic[:500], color='cyan')
axes[0, 0].axhline(0.92, color='r', linestyle='--', label='Clutch-Snap Threshold')
axes[0, 0].set_title('Se Saturation (Basic Model Short-term)')
axes[0, 0].legend()
# Panel 2: PSD Basic
# Avoid zero-frequency dominance when log-log plotting
axes[0, 1].loglog(freqs_se_basic[1:], psd_se_basic[1:], color='lime')
axes[0, 1].set_title('PSD (Basic Model Coherence Horizon)')
axes[0, 1].set_xlabel('Frequency')
axes[0, 1].set_ylabel('PSD')
# Panel 3: Se Enhanced short-term
axes[1, 0].plot(se_enhanced[:1000], color='magenta')
axes[1, 0].axhline(0.0497, color='r', ls='--')
axes[1, 0].set_title('Se Evolution (Enhanced Model Short-term)')
# Panel 4: PSD Enhanced
axes[1, 1].loglog(freqs_se_enhanced[1:], psd_se_enhanced[1:], color='orange')
axes[1, 1].set_title('PSD (Enhanced Model)')
axes[1, 1].set_xlabel('Frequency')
axes[1, 1].set_ylabel('PSD')
# Panel 5: Coupling Energy Ec (Enhanced)
axes[2, 0].plot(Ec_enhanced[:1000], color='white')
axes[2, 0].set_title('Coupling Energy (Ec Enhanced Model)')
# Panel 6: Resonance Map (Mean R vs Drive Frequency) + dump counts as secondary axis
ax6 = axes[2, 1]
freq_khz = freq_range_hz / 1000.0
ax6.plot(freq_khz, mean_r_values, marker='o', linestyle='-', color='red', label='Mean R(t)')
ax6.set_xlabel('Drive Frequency (kHz)')
ax6.set_ylabel('Mean R(t)', color='red')
ax6.set_title('Resonance Map: Mean R(t) vs Drive Frequency (short sweep)')
ax6_twin = ax6.twinx()
ax6_twin.plot(freq_khz, dump_counts, marker='s', linestyle='--', color='yellow', label='Dump Events')
ax6_twin.set_ylabel('Dump Events', color='yellow')
ax6.grid(True, linestyle='--', alpha=0.3)
plt.tight_layout(rect=[0, 0.03, 1, 0.96])
plt.show()
plt.style.use('default')
# ---- CSV summary with highlighted date below the plot ----
summary_date = datetime.utcnow().date().isoformat()
csv_buffer = io.StringIO()
writer = csv.writer(csv_buffer)
writer.writerow(['date', 'reset_count_basic', 'resets_enhanced', 'mean_R_sample', 'dump_events_sample', 'alpha_phys', 'model_alpha', 'gap'])
writer.writerow([
    summary_date,
    reset_count,
    resets_enhanced,
    float(np.mean(r_sample)) if r_sample.size > 0 else 0.0,
    dumps_sample,
    f"{alpha_phys:.8f}",
    f"{model_alpha:.8f}",
    f"{gap:.8f}"
])
csv_text = csv_buffer.getvalue().strip()
# Print CSV
print("--- CSV SUMMARY ---")
print(csv_text)
# Print highlighted date line
print("\n>>> HIGHLIGHT DATE:", summary_date, "<<<")
