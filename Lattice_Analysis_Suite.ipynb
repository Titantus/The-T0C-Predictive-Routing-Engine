        "id": "sweeps_and_phase"
      },
      "source": [
        "# ---- Additional sweeps, stats, and optional phase visualization ----\n",
        "# Example: cycle-aware Hz sweep that saves figure and prints detailed stats\n",
        "freq_range_hz_fast = np.linspace(44400, 45600, 25)\n",
        "num_cycles_sweep = 400\n",
        "mean_r_values_fast = []\n",
        "max_r_values_fast = []\n",
        "std_r_values_fast = []\n",
        "integrated_emf_fast = []\n",
        "dump_counts_fast = []\n",
        "for f in freq_range_hz_fast:\n",
        "    r_tmp, emf_tmp, dumps_tmp, dt_tmp = cycle_aware_pump(num_cycles=num_cycles_sweep, drive_freq_hz=f)\n",
        "    mean_r_values_fast.append(np.mean(r_tmp))\n",
        "    max_r_values_fast.append(np.max(r_tmp))\n",
        "    std_r_values_fast.append(np.std(r_tmp))\n",
        "    integrated_emf_fast.append(np.sum(np.abs(emf_tmp))*dt_tmp)\n",
        "    dump_counts_fast.append(dumps_tmp)\n",
        "# Save detailed stats to CSV file as well\n",
        "summary_rows = [\n",
        "    ['freq_hz','mean_R','max_R','std_R','int_abs_EMF','dumps']\n",
        "]\n",
        "for i, f in enumerate(freq_range_hz_fast):\n",
        "    summary_rows.append([int(f), mean_r_values_fast[i], max_r_values_fast[i], std_r_values_fast[i], integrated_emf_fast[i], dump_counts_fast[i]])\n",
        "csv_out_name = f'lattice_detailed_stats_{datetime.utcnow().strftime('%Y%m%d_%H%M%S')}.csv'\n",
        "with open(csv_out_name, 'w', newline='') as fh:\n",
        "    writer = csv.writer(fh)\n",
        "    writer.writerows(summary_rows)\n",
        "print(f'Saved detailed stats to {csv_out_name}')\n",
        "\n",
        "# Optional: phase-field visualization at best frequency from the fast sweep\n",
        "if len(mean_r_values_fast) > 0:\n",
        "    best_idx = int(np.argmax(mean_r_values_fast))\n",
        "    best_freq = freq_range_hz_fast[best_idx]\n",
        "    print(f'Peak mean R at {best_freq/1000.0:.3f} kHz')\n",
        "    # run snapshot for visualization\n",
        "    r_snap, emf_snap, dumps_snap, dt_snap, u_snap = cycle_aware_pump(num_cycles=800, drive_freq_hz=best_freq, nx=120, ny=80, snapshot=True)\n",
        "    dx = 1.0/120\n",
        "    u_dot_snap = (u_snap - np.roll(u_snap, 1, axis=1)) / (2*dt_snap + 1e-16)\n",
        "    grad_x_snap = (np.roll(u_snap, -1, 1) - np.roll(u_snap, 1, 1)) / (2*dx + 1e-16)\n",
        "    phases_snap = np.arctan2(u_dot_snap, grad_x_snap + 1e-8)\n",
        "    plt.style.use('dark_background')\n",
        "    plt.figure(figsize=(8,6))\n",
        "    plt.imshow(phases_snap, cmap='twilight', origin='lower')\n",
        "    plt.colorbar(label='Phase (rad)')\n",
        "    plt.title(f'Phase field at peak resonance {best_freq/1000.0:.3f} kHz')\n",
        "    outname_phase = f'phase_field_peak_{int(best_freq)}Hz_{datetime.utcnow().strftime('%Y%m%d_%H%M%S')}.png'\n",
        "    plt.savefig(outname_phase, dpi=180)\n",
        "    print(f'Saved phase field visualization to {outname_phase}')\n",
        "    plt.show()\n",
        "else:\n",
        "    print('Fast sweep not run yet; run the cell above to produce phase visualization')\n"
      ],
