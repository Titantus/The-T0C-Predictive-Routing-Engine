      "source": [
        "# Consolidated Lattice Analysis Suite\n",
        "# - Single cell: simulations + one 6-panel figure\n",
        ""\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from scipy.signal import welch\n",
        "from datetime import datetime\n",
        "import io, csv, os\n",
        "np.random.seed(42)\n",
        "# ---- Helper analysis functions ----\n",
        "def analyze_lattice_coherence(series, fs=1.0):\n",
        "    # Compute PSD via Welch; return freqs and PSD\n",
        "    # Series should be 1D numpy array\n",
        "    nperseg = min(2048, max(256, len(series)//8))\n",
        "    freqs, psd = welch(series, fs=fs, nperseg=nperseg)\n",
        "    return freqs, psd\n",
        "def quantify_alpha_gap():\n",
        "    # Minimal numeric \"alpha\" summary used in original notebook\n",
        "    alpha_phys = 1.0 / 137.035999\n",
        "    model_alpha = 1.0 / 137.0\n",
        "    gap = abs(alpha_phys - model_alpha)\n",
        "    return alpha_phys, model_alpha, gap\n",
        "# ---- Saturation / lattice functions (basic + enhanced) ----\n",
        "def basic_saturation(steps=5000, pc=0.95, noise=0.02):\n",
        "    se = np.zeros(steps)\n",
        "    resets = 0\n",
        "    for i in range(1, steps):\n",
        "        delta = np.random.normal(0.0, noise)\n",
        "        se[i] = np.clip(se[i-1] + delta, 0.0, 1.0)\n",
        "        if se[i] > pc:\n",
        "            se[i] = 0.1 * pc # small reset\n",
        "            resets += 1\n",
        "    return se, resets\n",
        "def enhanced_saturation(steps=20000, pc=0.0497, noise=0.008, wg=1.0, ww=1.0):\n",
        "    se = np.zeros(steps)\n",
        "    Ec = np.zeros(steps) # Coupling energy\n",
        "    mode = np.zeros(steps, dtype=int) # 0: Straight, 1: Loop\n",
        "    resets = 0\n",
        "    for i in range(1, steps):\n",
        "        phase_diff = np.cos(wg * i) * np.cos(ww * i)\n",
        "        Ec[i] = 0.5 * phase_diff\n",
        "        delta = np.random.normal(0.0, noise) + 0.1 * Ec[i]\n",
        "        se[i] = np.clip(se[i-1] + delta, 0.0, 1.0)\n",
        "        if se[i] > 0.92:\n",
        "            se[i] = pc * 2\n",
        "            resets += 1\n",
        "            mode[i] = 1\n",
        "        else:\n",
        "            mode[i] = 0 if np.abs(phase_diff) < 0.1 else 1\n",
        "    return se, Ec, mode, resets\n"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
