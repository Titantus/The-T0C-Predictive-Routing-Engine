      },
      "source": [
        "# ---- Cycle-aware pump (wave solver / Kuramoto-ish order) ----\n",
        "def cycle_aware_pump(num_cycles=200, drive_freq_hz=45000, nx=140, ny=90, c0=1.0, snapshot=False):\n",
        "    dx = 1.0 / nx\n",
        "    period = 1.0 / drive_freq_hz\n",
        "    total_time = num_cycles * period\n",
        "    N_points_per_period = 20\n",
        "    dt_temp_res = period / N_points_per_period\n",
        "    dt_courant = 0.42 * dx / c0\n",
        "    dt = min(dt_temp_res, dt_courant)\n",
        "    steps = max(1, int(total_time / dt))\n",
        "    # Tunable parameters\n",
        "    diotic_weight = 0.48\n",
        "    beta = 0.025\n",
        "    drive_amp = 0.01\n",
        "    strain_threshold = 0.038\n",
        "    u = np.zeros((ny, nx))\n",
        "    u_prev = np.zeros((ny, nx))\n",
        "    x = np.linspace(0, 1, nx)\n",
        "    y_grid = np.linspace(0, 1, ny)[:, None]\n",
        "    width = 1.0 - (1.0 - 0.25) * x\n",
        "    mask = (y_grid < width[None, :]).astype(float)\n",
        "    c_field = c0 * (1.0 + diotic_weight * (1.0 - y_grid / (width[None, :] + 1e-12)))\n",
        "    r_history = []\n",
        "    emf_history = []\n",
        "    dump_events = 0\n",
        "    dumping = False\n",
        "    dump_timer = 0\n",
        "    for t in range(steps):\n",
        "        laplacian = (np.roll(u, -1, 0) + np.roll(u, 1, 0) +\n",
        "                     np.roll(u, -1, 1) + np.roll(u, 1, 1) - 4 * u) / dx**2\n",
        "        u_new = 2 * u - u_prev + (dt**2 * c_field**2 * laplacian * mask)\n",
        "        noise = 0.12 * np.random.normal(0, 1, ny)\n",
        "        drive = drive_amp * np.sin(2 * np.pi * drive_freq_hz * t * dt)\n",
        "        u_new[:, 0] += noise + drive\n",
        "        u_new -= beta * (u_new ** 3)\n",
        "        # Kuramoto-like phase order parameter in a middle strip\n",
        "        u_dot = (u_new - u_prev) / (2 * dt + 1e-16)\n",
        "        grad_x = (np.roll(u_new, -1, 1) - np.roll(u_new, 1, 1)) / (2 * dx + 1e-16)\n",
        "        slice_x = slice(20, -20) if nx > 40 else slice(0, nx)\n",
        "        phases = np.arctan2(u_dot[:, slice_x], c0 * grad_x[:, slice_x] + 1e-8)\n",
        "        r_t = np.abs(np.mean(np.exp(1j * phases)))\n",
        "        r_history.append(r_t)\n",
        "        # Shishiodoshi valve\n",
        "        sink = x > 0.82\n",
        "        apex_strain = np.mean(np.abs(u_new[:, sink]))\n",
        "        emf = 0.0\n",
        "        if apex_strain > strain_threshold and not dumping:\n",
        "            dumping = True\n",
        "            dump_timer = 12\n",
        "            dump_events += 1\n",
        "        if dumping:\n",
        "            u_new[:, sink] *= 0.32\n",
        "            emf = 6200 * (apex_strain / (dt + 1e-16))\n",
        "            dump_timer -= 1\n",
        "            if dump_timer <= 0:\n",
        "                dumping = False\n",
        "        emf_history.append(emf)\n",
        "        u_prev, u = u, u_new\n",
        "    if snapshot:\n",
        "        return np.array(r_history), np.array(emf_history), dump_events, dt, u\n",
        "    return np.array(r_history), np.array(emf_history), dump_events, dt\n",
        "\n",
        "def enhanced_kuramoto_pump(drive_freq=None, drive_freq_hz=None, freq_scale=1e3, **kwargs):\n",
        "    # Wrapper: accepts either scaled drive_freq (e.g., kHz) or explicit drive_freq_hz\n",
        "    if drive_freq_hz is not None:\n",
        "        df_hz = drive_freq_hz\n",
        "    elif drive_freq is not None:\n",
        "        df_hz = float(drive_freq) * float(freq_scale)\n",
        "    else:\n",
        "        df_hz = kwargs.pop('drive_freq_hz', 45000)\n",
        "    return cycle_aware_pump(drive_freq_hz=df_hz, **kwargs)\n"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "run_sim_and_plot",
        "cellView": "form"
      },
      "source": [
        "# ---- Run simulations & produce consolidated figure ----\n",
        "# Basic and enhanced saturations\n",
        "se_basic, reset_count = basic_saturation(steps=5000, pc=0.92, noise=0.02)\n",
        "se_enhanced, Ec_enhanced, mode_enhanced, resets_enhanced = enhanced_saturation(steps=20000)\n",
        "# PSDs\n",
        "freqs_se_basic, psd_se_basic = analyze_lattice_coherence(se_basic, fs=1.0)\n",
        "freqs_se_enhanced, psd_se_enhanced = analyze_lattice_coherence(se_enhanced, fs=1.0)\n",
        "# Cycle-aware pump sample run + sweep for resonance map\n",
        "r_sample, emf_sample, dumps_sample, dt_sample = cycle_aware_pump(num_cycles=150, drive_freq_hz=45000)\n",
        "freq_range_hz = np.linspace(44500, 45500, 20)\n",
        "mean_r_values = []\n",
        "max_r_values = []\n",
        "std_r_values = []\n",
        "integrated_emf = []\n",
        "dump_counts = []\n",
        "for f in freq_range_hz:\n",
        "    r_tmp, emf_tmp, dumps_tmp, dt_tmp = cycle_aware_pump(num_cycles=120, drive_freq_hz=f)\n",
        "    mean_r_values.append(np.mean(r_tmp))\n",
        "    max_r_values.append(np.max(r_tmp))\n",
        "    std_r_values.append(np.std(r_tmp))\n",
        "    integrated_emf.append(np.sum(np.abs(emf_tmp))*dt_tmp)\n",
        "    dump_counts.append(dumps_tmp)\n",
        "# Quantify alpha metrics\n",
        "alpha_phys, model_alpha, gap = quantify_alpha_gap()\n",
        "# ---- Plot single 3x2 figure ----\n",
        "plt.style.use('dark_background')\n",
        "fig, axes = plt.subplots(nrows=3, ncols=2, figsize=(15, 12))\n",
        "fig.suptitle('Combined Simulation Analysis (Consolidated)', fontsize=16)\n",
        "# Panel 1: Se Basic (short-term)\n",
        "axes[0, 0].plot(se_basic[:500], color='cyan')\n",
        "axes[0, 0].axhline(0.92, color='r', linestyle='--', label='Clutch-Snap Threshold')\n",
        "axes[0, 0].set_title('Se Saturation (Basic Model Short-term)')\n",
        "axes[0, 0].legend()\n",
        "# Panel 2: PSD Basic\n",
        "axes[0, 1].loglog(freqs_se_basic[1:], psd_se_basic[1:], color='lime')\n",
        "axes[0, 1].set_title('PSD (Basic Model Coherence Horizon)')\n",
        "axes[0, 1].set_xlabel('Frequency')\n",
        "axes[0, 1].set_ylabel('PSD')\n",
        "# Panel 3: Se Enhanced short-term\n",
        "axes[1, 0].plot(se_enhanced[:1000], color='magenta')\n",
        "axes[1, 0].axhline(0.0497, color='r', ls='--')\n",
        "axes[1, 0].set_title('Se Evolution (Enhanced Model Short-term)')\n",
        "# Panel 4: PSD Enhanced\n",
        "axes[1, 1].loglog(freqs_se_enhanced[1:], psd_se_enhanced[1:], color='orange')\n",
        "axes[1, 1].set_title('PSD (Enhanced Model)')\n",
        "axes[1, 1].set_xlabel('Frequency')\n",
        "axes[1, 1].set_ylabel('PSD')\n",
        "# Panel 5: Coupling Energy Ec (Enhanced)\n",
        "axes[2, 0].plot(Ec_enhanced[:1000], color='white')\n",
        "axes[2, 0].set_title('Coupling Energy (Ec Enhanced Model)')\n",
        "# Panel 6: Resonance Map (Mean R vs Drive Frequency) + dump counts as secondary axis\n",
        "ax6 = axes[2, 1]\n",
        "freq_khz = freq_range_hz / 1000.0\n",
        "ax6.plot(freq_khz, mean_r_values, marker='o', linestyle='-', color='red', label='Mean R(t)')\n",
        "ax6.set_xlabel('Drive Frequency (kHz)')\n",
        "ax6.set_ylabel('Mean R(t)', color='red')\n",
        "ax6.set_title('Resonance Map: Mean R(t) vs Drive Frequency (short sweep)')\n",
        "ax6_twin = ax6.twinx()\n",
        "ax6_twin.plot(freq_khz, dump_counts, marker='s', linestyle='--', color='yellow', label='Dump Events')\n",
        "ax6_twin.set_ylabel('Dump Events', color='yellow')\n",
        "ax6.grid(True, linestyle='--', alpha=0.3)\n",
        "plt.tight_layout(rect=[0, 0.03, 1, 0.96])\n",
        "# Auto-save figure\n",
        "summary_date = datetime.utcnow().strftime('%Y%m%d_%H%M%S')\n",
        "outname = f'lattice_analysis_combined_{summary_date}.png'\n",
        "fig.savefig(outname, dpi=180)\n",
        "print(f'Saved combined figure to {outname}')\n",
        "plt.show()\n",
        "plt.style.use('default')\n",
        "# ---- CSV summary with highlighted date below the plot ----\n",
        "summary_date_iso = datetime.utcnow().date().isoformat()\n",
        "csv_buffer = io.StringIO()\n",
        "writer = csv.writer(csv_buffer)\n",
        "writer.writerow(['date', 'reset_count_basic', 'resets_enhanced', 'mean_R_sample', 'dump_events_sample', 'alpha_phys', 'model_alpha', 'gap'])\n",
        "writer.writerow([\n",
        "    summary_date_iso,\n",
        "    reset_count,\n",
        "    resets_enhanced,\n",
        "    float(np.mean(r_sample)) if r_sample.size > 0 else 0.0,\n",
        "    dumps_sample,\n",
        "    f\"{alpha_phys:.8f}\",\n",
        "    f\"{model_alpha:.8f}\",\n",
        "    f\"{gap:.8f}\"\n",
        "])\n",
        "csv_text = csv_buffer.getvalue().strip()\n",
        "# Print CSV\n",
        "print(\"--- CSV SUMMARY ---\")\n",
        "print(csv_text)\n",
        "# Print highlighted date line\n",
        "print(\"\n>>> HIGHLIGHT DATE:\", summary_date_iso, \"<<<\")\n"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
